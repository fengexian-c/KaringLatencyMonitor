<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="KaringLatencyMonitor.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:KaringLatencyMonitor.App.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:KaringLatencyMonitor.App.ViewModels"
    mc:Ignorable="d"
    Title="Karing 延迟监控">

    <Grid x:Name="RootGrid" Background="{ThemeResource MonitorApplicationBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="56" />
            <RowDefinition Height="*" />
            <RowDefinition Height="34" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Padding="18,0" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel VerticalAlignment="Center" Spacing="2">
                <TextBlock Text="Karing 延迟监控"
                           FontSize="20"
                           FontWeight="SemiBold" />
                <TextBlock Text="每个节点一行 · 最近24小时固定24格"
                           FontSize="12"
                           Foreground="{ThemeResource SecondaryTextBrush}" />
            </StackPanel>

            <ProgressRing Grid.Column="1"
                          Width="18"
                          Height="18"
                          IsActive="{x:Bind ViewModel.IsCollecting, Mode=OneWay}"
                          VerticalAlignment="Center" />

            <Button Grid.Column="2"
                    Click="RefreshGroupsButton_Click"
                    ToolTipService.ToolTip="刷新节点组">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE72C;" FontSize="14" />
                    <TextBlock Text="刷新分组" />
                </StackPanel>
            </Button>

            <Button Grid.Column="3"
                    Click="CollectNowButton_Click">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE895;" FontSize="14" />
                    <TextBlock Text="立即采集" />
                </StackPanel>
            </Button>
        </Grid>

        <Grid Grid.Row="1" Margin="16,0,16,12" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250" />
                <ColumnDefinition Width="*" MinWidth="600" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="{ThemeResource PanelBackgroundBrush}"
                    BorderBrush="{ThemeResource SubtleBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="12">
                <Grid RowSpacing="9">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Text="运行时节点组与统计范围"
                               FontSize="15"
                               FontWeight="SemiBold" />

                    <DropDownButton x:Name="GroupSelectorButton"
                                    Grid.Row="1"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Stretch"
                                    AutomationProperties.Name="选择节点组">
                        <TextBlock Text="{x:Bind ViewModel.SelectedGroupDisplayName, Mode=OneWay}"
                                   TextTrimming="CharacterEllipsis" />
                        <DropDownButton.Flyout>
                            <Flyout x:Name="GroupSelectorFlyout"
                                    Placement="BottomEdgeAlignedLeft"
                                    Opening="GroupSelectorFlyout_Opening">
                                <Flyout.FlyoutPresenterStyle>
                                    <Style TargetType="FlyoutPresenter">
                                        <Setter Property="Padding" Value="0" />
                                        <Setter Property="MinWidth" Value="0" />
                                        <Setter Property="MaxHeight" Value="260" />
                                        <Setter Property="CornerRadius" Value="8" />
                                    </Style>
                                </Flyout.FlyoutPresenterStyle>
                                <ListView x:Name="GroupSelectorList"
                                          MaxHeight="260"
                                          ItemsSource="{x:Bind ViewModel.Groups}"
                                          SelectedItem="{x:Bind ViewModel.SelectedGroup, Mode=OneWay}"
                                          SelectionMode="Single"
                                          SelectionChanged="GroupSelectorList_SelectionChanged">
                                    <ListView.ItemContainerStyle>
                                        <Style TargetType="ListViewItem">
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                            <Setter Property="MinHeight" Value="44" />
                                            <Setter Property="Padding" Value="12,0" />
                                        </Style>
                                    </ListView.ItemContainerStyle>
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="vm:GroupOptionViewModel">
                                            <TextBlock Text="{x:Bind DisplayName}"
                                                       VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis" />
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </Flyout>
                        </DropDownButton.Flyout>
                    </DropDownButton>

                    <TextBox x:Name="NodeSearchBox"
                             Grid.Row="2"
                             PlaceholderText="搜索节点"
                             TextChanged="NodeSearchBox_TextChanged" />

                    <Grid Grid.Row="3" ColumnSpacing="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0"
                                HorizontalAlignment="Stretch"
                                Click="SelectAllButton_Click"
                                Content="全选" />
                        <Button Grid.Column="1"
                                HorizontalAlignment="Stretch"
                                Click="ClearAllButton_Click"
                                Content="清空" />
                        <Button Grid.Column="2"
                                HorizontalAlignment="Stretch"
                                Click="InvertSelectionButton_Click"
                                Content="反选" />
                    </Grid>

                    <TextBlock Grid.Row="4"
                               Text="{x:Bind ViewModel.SelectionSummary, Mode=OneWay}"
                               FontSize="12"
                               Foreground="{ThemeResource SecondaryTextBrush}" />

                    <ListView x:Name="NodeSelectionList"
                              Grid.Row="5"
                              ItemsSource="{x:Bind ViewModel.VisibleNodes}"
                              AllowDrop="{x:Bind ViewModel.CanReorderNodes, Mode=OneWay}"
                              CanDragItems="{x:Bind ViewModel.CanReorderNodes, Mode=OneWay}"
                              CanReorderItems="{x:Bind ViewModel.CanReorderNodes, Mode=OneWay}"
                              DragItemsCompleted="NodeSelectionList_DragItemsCompleted"
                              SelectionMode="None">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="MinHeight" Value="32" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:NodeSelectionViewModel">
                                <Grid Opacity="{x:Bind PresenceOpacity}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="18" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Glyph="&#xE700;"
                                              FontSize="10"
                                              Opacity="0.55"
                                              VerticalAlignment="Center"
                                              ToolTipService.ToolTip="拖动调整默认顺序" />
                                    <CheckBox Grid.Column="1"
                                              IsChecked="{x:Bind IsSelected, Mode=TwoWay}"
                                              Click="NodeCheckBox_Click"
                                              HorizontalAlignment="Stretch">
                                        <StackPanel>
                                            <TextBlock Text="{x:Bind Tag}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{x:Bind PresenceText}"
                                                       FontSize="11"
                                                       Foreground="{ThemeResource SecondaryTextBrush}" />
                                        </StackPanel>
                                    </CheckBox>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <Expander Grid.Row="6" Header="连接与采集设置">
                        <StackPanel Spacing="7" Padding="0,8,0,0">
                            <TextBlock Text="控制器地址" FontSize="12" />
                            <TextBox Text="{x:Bind ViewModel.BaseUrl, Mode=TwoWay}" />

                            <TextBlock Text="API secret" FontSize="12" />
                            <PasswordBox Password="{x:Bind ViewModel.Secret, Mode=TwoWay}" />

                            <TextBlock Text="探测目标 URL" FontSize="12" />
                            <TextBox Text="{x:Bind ViewModel.TargetUrl, Mode=TwoWay}" />

                            <Grid ColumnSpacing="6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="超时(s)" FontSize="11" />
                                    <NumberBox Minimum="1" Maximum="60"
                                               SpinButtonPlacementMode="Compact"
                                               Value="{x:Bind ViewModel.TimeoutSeconds, Mode=TwoWay}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="并发" FontSize="11" />
                                    <NumberBox Minimum="1" Maximum="20"
                                               SpinButtonPlacementMode="Compact"
                                               Value="{x:Bind ViewModel.MaxConcurrency, Mode=TwoWay}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="周期(min)" FontSize="11" />
                                    <NumberBox Minimum="1" Maximum="1440"
                                               SpinButtonPlacementMode="Compact"
                                               Value="{x:Bind ViewModel.IntervalMinutes, Mode=TwoWay}" />
                                </StackPanel>
                            </Grid>

                            <ToggleSwitch Header="自动采集"
                                          IsOn="{x:Bind ViewModel.AutoCollectionEnabled, Mode=TwoWay}" />
                            <Button Content="保存设置"
                                    HorizontalAlignment="Stretch"
                                    Click="SaveSettingsButton_Click" />
                        </StackPanel>
                    </Expander>
                </Grid>
            </Border>

            <Border Grid.Column="1"
                    Background="{ThemeResource PanelBackgroundBrush}"
                    BorderBrush="{ThemeResource SubtleBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                <ScrollViewer HorizontalScrollMode="Auto"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollMode="Disabled"
                              VerticalScrollBarVisibility="Disabled">
                    <Grid Width="804">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="58" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0"
                              Background="{ThemeResource LayerBackgroundBrush}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="176" />
                                <ColumnDefinition Width="244" />
                                <ColumnDefinition Width="60" />
                                <ColumnDefinition Width="68" />
                                <ColumnDefinition Width="60" />
                                <ColumnDefinition Width="68" />
                                <ColumnDefinition Width="60" />
                                <ColumnDefinition Width="68" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="30" />
                                <RowDefinition Height="28" />
                            </Grid.RowDefinitions>

                            <StackPanel Grid.RowSpan="2"
                                        Orientation="Horizontal"
                                        Spacing="5"
                                        VerticalAlignment="Center"
                                        Margin="12,0">
                                <TextBlock Text="节点"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center" />
                                <Button Style="{StaticResource HeaderSortButtonStyle}"
                                        IsEnabled="{x:Bind ViewModel.CanRestoreDefaultSort, Mode=OneWay}"
                                        Click="RestoreDefaultSortButton_Click"
                                        AutomationProperties.Name="恢复默认节点顺序"
                                        ToolTipService.ToolTip="恢复左侧定义的默认顺序">
                                    <FontIcon Glyph="&#xE72C;" FontSize="11" />
                                </Button>
                            </StackPanel>

                            <Grid Grid.Column="1" Grid.RowSpan="2" Margin="4,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="30" />
                                    <RowDefinition Height="28" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="最近24小时"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                                <Grid Grid.Row="1">
                                    <TextBlock Text="-24h" FontSize="10" HorizontalAlignment="Left" />
                                    <TextBlock Text="-12h" FontSize="10" HorizontalAlignment="Center" />
                                    <TextBlock Text="当前" FontSize="10" HorizontalAlignment="Right" />
                                </Grid>
                            </Grid>

                            <TextBlock Grid.Column="2" Grid.ColumnSpan="2"
                                       Text="24小时"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                            <TextBlock Grid.Column="4" Grid.ColumnSpan="2"
                                       Text="7天"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                            <TextBlock Grid.Column="6" Grid.ColumnSpan="2"
                                       Text="30天"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />

                            <Border Grid.Column="4"
                                    Grid.RowSpan="2"
                                    Width="1"
                                    Margin="0,5"
                                    HorizontalAlignment="Left"
                                    Background="{ThemeResource SubtleBorderBrush}"
                                    IsHitTestVisible="False" />
                            <Border Grid.Column="6"
                                    Grid.RowSpan="2"
                                    Width="1"
                                    Margin="0,5"
                                    HorizontalAlignment="Left"
                                    Background="{ThemeResource SubtleBorderBrush}"
                                    IsHitTestVisible="False" />

                            <StackPanel Grid.Row="1" Grid.Column="2"
                                        Orientation="Horizontal"
                                        Spacing="1"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                <TextBlock Text="延迟" FontSize="11" VerticalAlignment="Center" />
                                <Button Style="{StaticResource HeaderSortButtonStyle}"
                                        Click="Hours24DelaySortButton_Click"
                                        AutomationProperties.Name="按24小时延迟排序"
                                        ToolTipService.ToolTip="按24小时平均延迟排序">
                                    <TextBlock Text="{x:Bind ViewModel.Hours24SortGlyph, Mode=OneWay}" />
                                </Button>
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="3"
                                        Orientation="Horizontal"
                                        Spacing="1"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                <TextBlock Text="可用率" FontSize="11" VerticalAlignment="Center" />
                                <Button Style="{StaticResource HeaderSortButtonStyle}"
                                        Click="Hours24AvailabilitySortButton_Click"
                                        AutomationProperties.Name="按24小时可用率排序"
                                        ToolTipService.ToolTip="按24小时可用率排序">
                                    <TextBlock Text="{x:Bind ViewModel.Hours24AvailabilitySortGlyph, Mode=OneWay}" />
                                </Button>
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="4"
                                        Orientation="Horizontal"
                                        Spacing="1"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                <TextBlock Text="延迟" FontSize="11" VerticalAlignment="Center" />
                                <Button Style="{StaticResource HeaderSortButtonStyle}"
                                        Click="Days7DelaySortButton_Click"
                                        AutomationProperties.Name="按7天延迟排序"
                                        ToolTipService.ToolTip="按7天平均延迟排序">
                                    <TextBlock Text="{x:Bind ViewModel.Days7SortGlyph, Mode=OneWay}" />
                                </Button>
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="5"
                                        Orientation="Horizontal"
                                        Spacing="1"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                <TextBlock Text="可用率" FontSize="11" VerticalAlignment="Center" />
                                <Button Style="{StaticResource HeaderSortButtonStyle}"
                                        Click="Days7AvailabilitySortButton_Click"
                                        AutomationProperties.Name="按7天可用率排序"
                                        ToolTipService.ToolTip="按7天可用率排序">
                                    <TextBlock Text="{x:Bind ViewModel.Days7AvailabilitySortGlyph, Mode=OneWay}" />
                                </Button>
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="6"
                                        Orientation="Horizontal"
                                        Spacing="1"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                <TextBlock Text="延迟" FontSize="11" VerticalAlignment="Center" />
                                <Button Style="{StaticResource HeaderSortButtonStyle}"
                                        Click="Days30DelaySortButton_Click"
                                        AutomationProperties.Name="按30天延迟排序"
                                        ToolTipService.ToolTip="按30天平均延迟排序">
                                    <TextBlock Text="{x:Bind ViewModel.Days30SortGlyph, Mode=OneWay}" />
                                </Button>
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="7"
                                        Orientation="Horizontal"
                                        Spacing="1"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                <TextBlock Text="可用率" FontSize="11" VerticalAlignment="Center" />
                                <Button Style="{StaticResource HeaderSortButtonStyle}"
                                        Click="Days30AvailabilitySortButton_Click"
                                        AutomationProperties.Name="按30天可用率排序"
                                        ToolTipService.ToolTip="按30天可用率排序">
                                    <TextBlock Text="{x:Bind ViewModel.Days30AvailabilitySortGlyph, Mode=OneWay}" />
                                </Button>
                            </StackPanel>
                        </Grid>

                        <ListView Grid.Row="1"
                                  ItemsSource="{x:Bind ViewModel.Rows}"
                                  SelectionMode="None">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="MinHeight" Value="36" />
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="vm:NodeStatisticsRowDisplay">
                                    <Grid Width="804"
                                          Height="36"
                                          Opacity="{x:Bind PresenceOpacity}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="176" />
                                            <ColumnDefinition Width="244" />
                                            <ColumnDefinition Width="60" />
                                            <ColumnDefinition Width="68" />
                                            <ColumnDefinition Width="60" />
                                            <ColumnDefinition Width="68" />
                                            <ColumnDefinition Width="60" />
                                            <ColumnDefinition Width="68" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Text="{x:Bind Tag}"
                                                   Margin="12,0"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTipService.ToolTip="{x:Bind Tag}" />

                                        <controls:HeatmapStrip Grid.Column="1"
                                                               Cells="{x:Bind HourCells}"
                                                               HorizontalAlignment="Left"
                                                               VerticalAlignment="Top"
                                                               Margin="4,11,0,0" />

                                        <TextBlock Grid.Column="2" Text="{x:Bind Hours24.DelayText}" Style="{StaticResource StatisticTextStyle}" ToolTipService.ToolTip="{x:Bind Hours24.TooltipText}" />
                                        <TextBlock Grid.Column="3" Text="{x:Bind Hours24.AvailabilityText}" Style="{StaticResource StatisticTextStyle}" ToolTipService.ToolTip="{x:Bind Hours24.TooltipText}" />
                                        <TextBlock Grid.Column="4" Text="{x:Bind Days7.DelayText}" Style="{StaticResource StatisticTextStyle}" ToolTipService.ToolTip="{x:Bind Days7.TooltipText}" />
                                        <TextBlock Grid.Column="5" Text="{x:Bind Days7.AvailabilityText}" Style="{StaticResource StatisticTextStyle}" ToolTipService.ToolTip="{x:Bind Days7.TooltipText}" />
                                        <TextBlock Grid.Column="6" Text="{x:Bind Days30.DelayText}" Style="{StaticResource StatisticTextStyle}" ToolTipService.ToolTip="{x:Bind Days30.TooltipText}" />
                                        <TextBlock Grid.Column="7" Text="{x:Bind Days30.AvailabilityText}" Style="{StaticResource StatisticTextStyle}" ToolTipService.ToolTip="{x:Bind Days30.TooltipText}" />

                                        <Border Grid.Column="4"
                                                Width="1"
                                                Margin="0,4"
                                                HorizontalAlignment="Left"
                                                Background="{ThemeResource SubtleBorderBrush}"
                                                IsHitTestVisible="False" />
                                        <Border Grid.Column="6"
                                                Width="1"
                                                Margin="0,4"
                                                HorizontalAlignment="Left"
                                                Background="{ThemeResource SubtleBorderBrush}"
                                                IsHitTestVisible="False" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </ScrollViewer>
            </Border>
        </Grid>

        <Border Grid.Row="2"
                BorderBrush="{ThemeResource SubtleBorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="16,0">
            <TextBlock Text="{x:Bind ViewModel.StatusText, Mode=OneWay}"
                       VerticalAlignment="Center"
                       FontSize="12"
                       TextTrimming="CharacterEllipsis" />
        </Border>
    </Grid>
</Window>
